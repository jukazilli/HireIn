# HireIn local pilot defaults. Never commit a real .env or real credentials.
#
# Default P0 runtime: PostgreSQL in compose.yaml, kept on the local machine.
# To use Neon or another PostgreSQL later, copy this file to .env and replace DATABASE_URL locally.
DATABASE_URL=postgresql+psycopg://hirein:hirein@localhost:5432/hirein
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
